{
  "headers": [
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }]
    }
  ],
  "functions": {
    "api/callsheets.ts": { "maxDuration": 150, "includeFiles": "test/data/**" },
    "api/worker.ts": { "maxDuration": 300, "includeFiles": "test/data/**" },
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "test/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/google/(.*)", "destination": "/api/google" },
    { "source": "/api/user/(.*)", "destination": "/api/user" },
    { "source": "/api/stripe/(.*)", "destination": "/api/stripe" },
    { "source": "/api/callsheets/(.*)", "destination": "/api/callsheets" },
    { "source": "/api/climatiq/(.*)", "destination": "/api/external" },
    { "source": "/api/electricity-maps/(.*)", "destination": "/api/external" },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|sw\\.js$|workbox-.*\\.js$|manifest\\.webmanifest$|favicon\\.ico$|logo\\.svg$).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "silent": false,
    "autoAlias": true
  }
}
